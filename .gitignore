# --- Plugin-specific runtime/generated files ---
# guess: 图片库（运行时可变的题库/图片）
xiaozu_bot/plugins/guess/data/
xiaozu_bot/plugins/guess/data/**
xiaozu_bot/plugins/guess/pictures/
xiaozu_bot/plugins/guess/pictures/**

# say: 生成的临时音频与缓存
xiaozu_bot/plugins/say/audios/
xiaozu_bot/plugins/say/*.wav
xiaozu_bot/plugins/say/*.mp3

# gdlevelsearch: 本地缓存/临时数据（如自动抓取的 levels 缓存）
xiaozu_bot/plugins/gdlevelsearch/data/*.json
xiaozu_bot/plugins/gdlevelsearch/data/*.cache
xiaozu_bot/plugins/gdlevelsearch/data/*.tmp
# updater 跑一半的中间产物，跑完才会搬进上面那层
xiaozu_bot/plugins/gdlevelsearch/data/.staging/

# 所有插件的 data/ 一律不进仓库。
# 这里面是运行时数据（人品、游戏局面、题库、关卡缓存……），而且每个插件在
# **模块级**就 `r = JsonRedis(plugin_storage(__file__))`，也就是说光 import
# 就会把 data/storage.json 连目录一起建出来。
#
# 以前这里是一个插件一行（zhua/ jrrp/ roulette/ game/ ...）。别再那样写：
# 那样每加一个新插件，CI 的「干净检出守卫」都会在它第一次 push 时红一次，
# 直到你想起来回来补一行。用通配符一次性覆盖掉这一整类。
xiaozu_bot/plugins/*/data/
